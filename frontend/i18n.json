{
  "$schema": "https://lingo.dev/schema/i18n.json",
  "version": "1.12",
  "locale": {
    "source": "en",
    "targets": [
      "es",
      "fr",
      "de",
      "hi"
    ]
  },
  "buckets": {
    "json": {
      "include": [
        "locales/[locale].json"
      ]
    }
  },
  "provider": {
    "id": "openai",
    "model": "gpt-4o-mini",
    "prompt": "Translate the provided text from {source} to {target}."
  }
}