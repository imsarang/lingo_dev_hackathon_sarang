{
  "name": "backend",
  "version": "1.0.0",
  "description": "backend for lingo_dev hackathon",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "inspect": "ts-node src/scripts/inspect-chromadb.ts",
    "chromadb:start": "docker-compose -f docker-compose.chromadb.yml up -d",
    "chromadb:stop": "docker-compose -f docker-compose.chromadb.yml down",
    "chromadb:logs": "docker-compose -f docker-compose.chromadb.yml logs -f"
  },
